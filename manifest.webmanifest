{
  "name": "VisaSnap",
  "short_name": "VisaSnap",
  "description": "Create passport and e-visa photos from your phone, even offline.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f5fbff",
  "theme_color": "#0891b2",
  "categories": ["travel", "utilities", "photo"],
  "shortcuts": [
    {
      "name": "Photo Tool",
      "short_name": "Photo",
      "description": "Open the passport photo editor.",
      "url": "./index.html#photo",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "E-visa Links",
      "short_name": "E-visa",
      "description": "Open official e-visa destination links.",
      "url": "./index.html#evisa",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
